# Copy to .env.local and fill in values.
# .env.local is git-ignored.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset for local dev — analytics auto-disables in non-production builds.
NEXT_PUBLIC_GA_ID=

# Base path for static export when deployed under a repo path.
# Set to "/plyvo" for GitHub Pages project site; leave empty for custom domain.
PLYVO_BASE_PATH=
